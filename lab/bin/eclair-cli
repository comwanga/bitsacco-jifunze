#!/usr/bin/env python3
"""eclair-cli for the lab: `eclair-cli getinfo`, `eclair-cli open --nodeId=... --fundingSatoshis=...`."""
import json
import sys

from jifunze_lab.cli import CliTargetError, parse_value, target_node, wrong_cli
from jifunze_lab.clients import EclairREST, LabClientError
from jifunze_lab.nodes import nodes

name = target_node("chan")
node = nodes().get(name)
if node is None or node.impl != "eclair":
    e: CliTargetError = wrong_cli("eclair-cli", name)
    print(e, file=sys.stderr)
    if node is not None and node.name == "chan":
        print("Chan runs Eclair only in the full profile: ./lab up --full", file=sys.stderr)
    sys.exit(e.code)

args = [a for a in sys.argv[1:] if not a.startswith("-p")]
method = next((a for a in args if not a.startswith("--")), None)
if not method:
    print("usage: eclair-cli <method> [--param=value ...]", file=sys.stderr)
    sys.exit(2)
params = {}
for a in args:
    if a.startswith("--"):
        k, _, v = a[2:].partition("=")
        params[k] = v
try:
    print(json.dumps(EclairREST(node).call(method, **params), indent=2))
except LabClientError as err:
    print(err, file=sys.stderr)
    sys.exit(1)
