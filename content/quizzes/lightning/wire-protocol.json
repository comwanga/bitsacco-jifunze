    {
      "id": "q1",
      "prompt": {
        "sw": "Ujumbe wa init ni aina gani?",
        "en": "What type number is the init message?"
      },
      "options": [
        {
          "id": "a",
          "label": {
            "sw": "16",
            "en": "16"
          }
        },
        {
          "id": "b",
          "label": {
            "sw": "1",
            "en": "1"
          }
        },
        {
          "id": "c",
          "label": {
            "sw": "256",
            "en": "256"
          }
        }
      ],
      "answer": "a",
      "explanation": {
        "sw": "0x0010 = 16.",
        "en": "0x0010 = 16."
      }
    },
    {
      "id": "q2",
      "prompt": {
