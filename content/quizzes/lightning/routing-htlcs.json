      },
      "options": [
        {
          "id": "a",
          "label": {
            "sw": "Hashi ya malipo kwenye ankara",
            "en": "The payment hash in the invoice"
          }
        },
        {
          "id": "b",
          "label": {
            "sw": "Anwani ya Dina",
            "en": "Dina's address"
          }
        },
        {
          "id": "c",
          "label": {
            "sw": "Kiasi",
            "en": "The amount"
          }
        }
      ],
      "answer": "a",
      "explanation": {
        "sw": "Hiyo ndiyo inafanya preimage kuwa risiti.",
