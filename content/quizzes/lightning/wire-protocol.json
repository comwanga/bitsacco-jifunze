      },
      "options": [
        {
          "id": "a",
          "label": {
            "sw": "Kukatisha muunganisho",
            "en": "Disconnect"
          }
        },
        {
          "id": "b",
          "label": {
            "sw": "Kufunga chaneli zote",
            "en": "Close all channels"
          }
        },
        {
          "id": "c",
          "label": {
            "sw": "Kuipuuza",
            "en": "Ignore it"
          }
        }
      ],
      "answer": "c",
      "explanation": {
        "sw": "Ni sawa kuwa witiri: biti witiri ni hiari.",
        "en": "It's OK to be odd: odd bits are optional."
      }
    },
    {
