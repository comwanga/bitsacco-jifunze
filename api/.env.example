# Copy to api/.env.local (git-ignored) for `docker compose up`. Never commit real values.
# SITE_ORIGIN, PORT and DATABASE_URL are set in compose.yaml.

# From the GitHub App's settings page. Register all three callback URLs:
#   http://localhost:8080/api/auth/github/callback
#   http://localhost:8080/api/auth/github/callback/reauth
#   http://localhost:8080/api/auth/github/callback/replace
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# At least 32 random bytes, base64. Generate with: openssl rand -base64 32
# Keep it: recovery codes are checked against it, so changing it invalidates every issued code.
RECOVERY_PEPPER_V1=replace-me
