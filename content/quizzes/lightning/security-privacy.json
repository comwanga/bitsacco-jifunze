      "options": [
        {
          "id": "a",
          "label": {
            "sw": "Hashi yake ni ya bahati nasibu; hakuna preimage",
            "en": "Its hash is random; nobody has the preimage"
          }
        },
        {
          "id": "b",
          "label": {
            "sw": "Hayana ada",
            "en": "They pay no fee"
          }
        },
        {
          "id": "c",
          "label": {
            "sw": "Yamezuiwa na benki",
            "en": "A bank blocks them"
          }
        }
      ],
      "answer": "a",
      "explanation": {
        "sw": "Dina anajibu kwamba hajui malipo hayo.",
