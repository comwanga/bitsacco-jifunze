{
  "name": "Jifunze Lightning lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [7777],
  "portsAttributes": { "7777": { "label": "Jifunze lab bridge", "onAutoForward": "notify" } },
  "containerEnv": {
    "JIFUNZE_ORIGINS": "https://jifunze.bitsacco.com,http://localhost:3000"
  },
  "postStartCommand": "cd lab && ./lab up && (gh codespace ports visibility 7777:public -c \"$CODESPACE_NAME\" || echo 'Make port 7777 public in the Ports tab') && ./lab pair"
}
