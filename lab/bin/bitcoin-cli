#!/usr/bin/env python3
"""bitcoin-cli for the lab (JSON-RPC to the regtest bitcoind). Supports -rpcwallet=NAME and -generate N."""
import json
import sys

from jifunze_lab.cli import parse_value
from jifunze_lab.clients import BitcoinRPC, LabClientError

wallet = None
args = []
for a in sys.argv[1:]:
    if a.startswith("-rpcwallet="):
        wallet = a.split("=", 1)[1]
    elif a in ("-regtest", "-named") or a.startswith("-rpc") or a.startswith("-datadir"):
        continue
    else:
        args.append(a)
rpc = BitcoinRPC(wallet)
try:
    if args and args[0] == "-generate":
        n = int(args[1]) if len(args) > 1 else 1
        result = rpc.mine(n)
    elif not args:
        print("usage: bitcoin-cli <method> [params...]", file=sys.stderr)
        sys.exit(2)
    else:
        result = rpc.call(args[0], *[parse_value(p) for p in args[1:]])
except LabClientError as err:
    print(err, file=sys.stderr)
    sys.exit(1)
print(result if isinstance(result, str) else json.dumps(result, indent=2))
